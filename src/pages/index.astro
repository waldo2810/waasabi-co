---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base>
  <div class="space-y-4">

    <p>Software Engineer working in Consulting</p>

    <div class="space-y-2">
      <h2 class="text-lg font-bold">Writing</h2>

      {posts.map((post) => (
        <a class="flex items-center justify-between" href={`/blog/${post.id}`}>
          <h3>{post.data.title}</h3>
          <span class="text-sm text-gray-500">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
        </a>
      ))}
    </div>

    <div class="space-y-2">
      <h2 class="text-lg font-bold">Apps</h2>

      <div class="space-y-2 sm:flex sm:items-center sm:gap-2">
        <a class="flex items-center gap-2" target="_blank" href={`https://lattice.waasabi.co`}>
          <img src="/lattice.svg" alt="" class="w-5 h-5" />
          <h3>Lattice</h3>
        </a>
        <span class="hidden sm:inline sm:text-sm sm:text-gray-500">Place windows in your Macbook exactly where you want them</span>
      </div>

      <div class="sm:flex sm:items-center sm:gap-2">
        <a class="flex items-center gap-2" target="_blank" href={`https://bookitup.co`}>
          <img src="/bookitup.svg" alt="" class="w-5 h-5" />
          <h3>Bookitup</h3>
        </a>
        <span class="hidden sm:inline sm:text-sm sm:text-gray-500">Manage reservations for your business effectively</span>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <h2 class="text-lg font-bold">Contact & Socials</h2>

      <a href={`mailto:contact@waasabi.co`}>
        <span>Email</span>
      </a>

      <a href={`https://are.na/waldo-sobrino`}>
        <span>Are.na</span>
      </a>
    </div>

  </div>
</Base>
